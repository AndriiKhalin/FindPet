{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AzureStorage": {
    "ConnectionString": "ConnectToYourAzureStorage",
    "ContainerName": "Container-Name"
  },
  "AzureBlobStorage": {
    "BaseUrl": "BaseUrlToYourAzureBlobStorage",
    "AllowedImageTypes": ["image/jpeg", "image/png", "image/webp", "image/gif"],
    "MaxFileSizeBytes": 5242880,
    "ImageQuality": 85,
    "ThumbnailSize": {
      "Width": 300,
      "Height": 300
    }
  },
  "API_url": "YourApiUrl",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb":
      "Server=(local);Database=NameYourDatabase;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Redis": "port:connection"
  },
  "Redis": {
    "InstanceName": "",
    "DefaultExpirationMinutes": 5
  },
  "JwtSettings": {
    "ValidAudience": "",
    "ValidIssuer": "",
    "Secret": "YourSecretPassword",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "EmailSettings": {
    "ApiKey": "YOUR_BREVO_API_KEY_HERE",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "your-email@gmail.com",
    "SmtpPassword": "your-16-char-app-password",
    "EnableSsl": true,
    "FromEmail": "noreply@findpet.com",
    "FromName": "FindPet Team",
    "BaseUrl": "https://localhost:4200",
    "EnableEmailSending": true
  }
}